# Базовый образ с минимальной версией Python.
# WORKDIR задаёт рабочую директорию приложения внутри контейнера.
FROM python:3.12-slim

WORKDIR /app


# Устанавливаем зависимости приложения.
# requirements.txt копируется отдельно, чтобы Docker мог использовать
# кэш этого слоя, если зависимости не изменились.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt


# Копируем исходный код приложения в контейнер.
COPY *.py .


# Команда, выполняемая при запуске контейнера.
# -u отключает буферизацию вывода Python, поэтому логи сразу
# появляются в docker logs.
CMD ["python", "-u", "app.py"]